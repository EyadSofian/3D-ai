# ───────────────────────────────── الصوت ─────────────────────────────────
# elevenlabs = أحلى صوت عربي + وسوم أداء ([يهمس] [يضحك]) + توقيت لكل حرف
#              => أدق lip sync ممكن
# openai     = شغّال على نفس مفتاح الموديل، من غير توقيتات (بتتحسب من مدة الصوت)
# فاضية      = ElevenLabs لو مفتاحه موجود، وإلا OpenAI
VOICE_PROVIDER=

# ─────────────────────────────── ElevenLabs ───────────────────────────────
# https://elevenlabs.io/app/settings/api-keys
# مهم: المفتاح بيبدأ بـ sk_  وبيظهر مرة واحدة بس وقت الإنشاء/التدوير.
# اللي في الصفحة تحت الاسم دا رقم الـ ID مش المفتاح — لو نسخته هيرجّعلك
# "API key ID used as API key". اضغط Rotate عشان تاخد واحد جديد.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# صوت عربي — شوف https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=IES4nrmZdUBHByLBde0P
# eleven_v3 = أكتر تعبيرًا (بيفهم وسوم الأداء) · eleven_turbo_v2_5 = أسرع
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_STT_MODEL=scribe_v1

# ─────────────────────────── الموديل اللي بيرد ───────────────────────────
# openai | anthropic — سيبها فاضية وهيختار اللي مفتاحه موجود
LLM_PROVIDER=openai

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# gpt-4o-mini أسرع وأرخص (الأنسب لمحادثة صوتية) · gpt-4o أذكى
OPENAI_MODEL=gpt-4o-mini

# صوت OpenAI (بيتستخدم لو VOICE_PROVIDER=openai)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_STT_MODEL=gpt-4o-transcribe

# Claude (بديل) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ───────────────────────────── الأفاتار ─────────────────────────────
# فاضي = يستخدم /models/majed.glb — شخصية RocketBox (MIT) براس عربي بدقن
# وثوب وغترة، وفيها 52 ARKit + 15 viseme أصلية.
# تبديل الشخصية (113 متاحة):
#   python3 tools/rocketbox_to_glb.py --fetch Male_Adult_21 public/models/majed.glb
# أو حط هنا مسار/رابط أي موديل تاني فيه ARKit/Oculus visemes.
AVATAR_URL=

PORT=5178
